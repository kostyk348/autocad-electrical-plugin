<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Сборка под AutoCAD 2014 (R19.1, .NET Framework 4.5).
    ТРЕБУЕТ установленного AutoCAD 2014 (managed API DLL берутся из его папки).

    dotnet build src/El.Plugin.2014/El.Plugin.2014.csproj -c Release
    -p:Acad2014Path="C:\Program Files\Autodesk\AutoCAD 2014"
  -->

  <PropertyGroup>
    <TargetFramework>net45</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>El.Plugin</RootNamespace>
    <AssemblyName>El.Plugin.2014</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <PlatformTarget>x64</PlatformTarget>
    <Acad2014Path Condition="'$(Acad2014Path)' == ''">C:\Program Files\Autodesk\AutoCAD 2014</Acad2014Path>
    <Version>1.8.0</Version>
    <AssemblyVersion>1.8.0.0</AssemblyVersion>
    <FileVersion>1.8.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net45" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <!-- переиспользуем исходники El.Plugin (единый код, два таргета) -->
  <ItemGroup>
    <Compile Include="..\El.Plugin\**\*.cs" Exclude="..\El.Plugin\obj\**;..\El.Plugin\bin\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\El.Core\El.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="acmgd">
      <HintPath>$(Acad2014Path)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(Acad2014Path)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(Acad2014Path)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcWindows">
      <HintPath>$(Acad2014Path)\AcWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(Acad2014Path)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <Target Name="CopyPlugin" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\bin\plugin-2014" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>El.Plugin</RootNamespace>
    <AssemblyName>El.Plugin</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <PlatformTarget>x64</PlatformTarget>
    <AcadPath Condition="'$(AcadPath)' == ''">C:\Program Files\Autodesk\AutoCAD 2024</AcadPath>
    <Version>1.8.0</Version>
    <AssemblyVersion>1.8.0.0</AssemblyVersion>
    <FileVersion>1.8.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\El.Core\El.Core.csproj" />
  </ItemGroup>

  <!-- El.Core сливается в плагин (ILRepack): ОДНА сборка, без конфликтов версий -->
  <Target Name="ILRepackMerge" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\..\..\tools\ilrepack\ILRepack.exe&quot; /lib:&quot;$(AcadPath)&quot; /internalize /target:library /out:&quot;$(TargetDir)$(AssemblyName).merged.dll&quot; &quot;$(TargetPath)&quot; &quot;$(TargetDir)El.Core.dll&quot;" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).merged.dll" DestinationFiles="$(TargetPath)" OverwriteReadOnlyFiles="true" />
    <Delete Files="$(TargetDir)$(AssemblyName).merged.dll" />
  </Target>

  <ItemGroup>
    <Reference Include="acmgd">
      <HintPath>$(AcadPath)\acmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadPath)\acdbmgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AcadPath)\accoremgd.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AcWindows">
      <HintPath>$(AcadPath)\AcWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AcadPath)\AdWindows.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- копирование результата в папку bin\plugin при сборке -->
  <Target Name="CopyPlugin" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)El.Core.dll" DestinationFolder="$(MSBuildProjectDirectory)\..\..\bin\plugin" />
  </Target>

</Project>

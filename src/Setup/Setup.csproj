<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>El.Setup</RootNamespace>
    <AssemblyName>El.Tools.Setup</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <ApplicationIcon />
    <Version>1.13.0</Version>
    <AssemblyVersion>1.13.0.0</AssemblyVersion>
    <FileVersion>1.13.0.0</FileVersion>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <!-- Полезная нагрузка: сборки плагина зашиваются в exe, чтобы установщик был один файл. -->
  <ItemGroup>
    <EmbeddedResource Include="payload/El.Plugin.2024.dll" LogicalName="El.Plugin.2024.dll" Condition="Exists('payload/El.Plugin.2024.dll')" />
    <EmbeddedResource Include="payload/El.Plugin.2027.dll" LogicalName="El.Plugin.2027.dll" Condition="Exists('payload/El.Plugin.2027.dll')" />
  </ItemGroup>

</Project>

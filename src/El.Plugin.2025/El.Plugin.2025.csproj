<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Сборка для AutoCAD 2025/2026 (.NET 8, серии R25.0–R25.1).
    Исходники те же, что у сборок 2024 и 2027 — отличается только платформа и пакет managed-API.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>El.Plugin</RootNamespace>
    <AssemblyName>El.Plugin</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.12.0</Version>
    <AssemblyVersion>1.12.0.0</AssemblyVersion>
    <FileVersion>1.12.0.0</FileVersion>
    <NoWarn>$(NoWarn);CA1416;MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../El.Plugin/**/*.cs" />
    <ProjectReference Include="../El.Core/El.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="25.0.0" />
  </ItemGroup>

</Project>
